# SOMATRIQ — environment variables (spec §209)
# Copy to .env and fill in real values. NEVER commit real values.

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=somatriq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=somatriq
# Private network only — never published (ADR 0011)
DATABASE_URL=postgresql+asyncpg://somatriq:change-me@somatriq_postgres:5432/somatriq

# ── Application ─────────────────────────────────────────────
SOMATRIQ_ENV=production
SOMATRIQ_VERSION=0.0.0
SOMATRIQ_HOST=somatriq.example.com   # single origin; web=/ api=/api mcp=/mcp (ADR 0007/0014)
SECRET_KEY=change-me                 # session signing
USER_TIMEZONE=Europe/Madrid

# ── Authentication ──────────────────────────────────────────
# Local account (Argon2id) is created by the first-run wizard (ADR 0015)
# SECRET_KEY above signs the web session JWTs (HS256, 12h)
SESSION_COOKIE_SECURE=true
# Transitional M1 ingest guard; device tokens (pairing) are the real path
# INGEST_TOKEN=

# ── Raw blob store (ADR 0003, spec §48-50) ─────────────────
# Compose sets this for the api service; recorded here for completeness
SOMATRIQ_RAW_DIR=/var/lib/somatriq/raw

# ── Mobile pairing ──────────────────────────────────────────
PAIRING_SESSION_TTL_MINUTES=10

# ── AI provider ─────────────────────────────────────────────
# Local-only by default; external providers require explicit opt-in (ADR 0009)
AI_PRIVACY_LEVEL=summary_only|aggregates|detailed   # default: aggregates when local provider used
OLLAMA_BASE_URL=http://host.docker.internal:11434
# External providers are DISABLED unless explicitly enabled:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_ALLOW_EXTERNAL=false

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ntfy ────────────────────────────────────────────────────
NTFY_PUBLIC_URL=
NTFY_INTERNAL_URL=http://somatriq_ntfy:80

# ── Backup ──────────────────────────────────────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=change-me
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

# ── MCP ─────────────────────────────────────────────────────
# OAuth 2.1 resource server + scoped PAT fallback (ADR 0010)
MCP_AUTH_ISSUER=https://somatriq.example.com
MCP_DEFAULT_SCOPES=health.read

# ── Observability ───────────────────────────────────────────
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=
